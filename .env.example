# -------------------------------------------------------
# LLM — Qwen3 via Ollama (corre local, sin API key)
# Instalar: https://ollama.com  →  ollama pull qwen3:8b
# -------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# -------------------------------------------------------
# Embeddings — Google Gemini (API gratuita, sin tarjeta)
# Obtener key: https://aistudio.google.com/apikey
# -------------------------------------------------------
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_EMBEDDING_MODEL=text-embedding-004

# -------------------------------------------------------
# Vector Store — Chroma (local en disco)
# -------------------------------------------------------
VECTOR_STORE=chroma
CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION=documents

# -------------------------------------------------------
# Chunking
# -------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4

# -------------------------------------------------------
# Rutas locales
# -------------------------------------------------------
UPLOAD_PATH=./data/uploads
LOG_PATH=./data/query_log.jsonl
